# 1. cp .env.example .env && chmod 600 .env
# 2. Fill locally. Never paste keys into chat or commit this file with real values.
# Values containing $ or # should be enclosed in single quotes.
# This makes plain `docker compose up -d` select the production file (no build).
COMPOSE_FILE=docker-compose.prod.yml
# Public v0.1.1 (MIT). No GHCR login required. Immutable release digest:
OMNI_IMAGE=ghcr.io/fecabrall/omni-action-hub@sha256:35abfee2a453caa0e22d92abe43799b28a4dd0b890a04fd1eded808bd544c4ee
# Plow: https://github.com/plow-pbc/plow-agents#quickstart
# Run login -> lines -> mint from this project folder. Keep credentials mode 0600.
PLOW_CREDENTIALS_FILE=./plow-credentials
# Gemini API key: https://aistudio.google.com/app/apikey
# Help: https://ai.google.dev/gemini-api/docs/api-key (billing/quota is per account).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Linear personal API key: https://linear.app/settings/api
# Select a team you can create issues/upload files in.
LINEAR_API_KEY=
# Linear: open your team -> command menu -> Copy model UUID. Not the team slug.
LINEAR_TEAM_ID=
# Optional project UUID in that same team. Leave blank if not used.
LINEAR_PROJECT_ID=
# After mint: python3 scripts/setup.py --chat-id (prints only your authorized cht_... ID).
OMNI_ALLOWED_CHAT_ID=
OMNI_WORKERS=2
# Maintainer fills this after official registration. It is not an API key.
# Without a registered ID the app works, but competition reporting is pending.
AGENT_ID=
