# ─── Omni-Action Hub — Configuração ──────────────────────────────────────────
#
# 1. cp .env.example .env && chmod 600 .env
# 2. Preencha todas as variáveis abaixo.
# 3. docker compose -f docker-compose.prod.yml up -d
#
# Nunca commite este arquivo com valores reais.
# Valores com $ ou # devem ficar entre aspas simples: CHAVE='valor$especial'
# ─────────────────────────────────────────────────────────────────────────────

# ─── Docker / Imagem ────────────────────────────────────────────────────────
# Imagem pública (MIT). Sem necessidade de login no GHCR.
COMPOSE_FILE=docker-compose.prod.yml
OMNI_IMAGE=ghcr.io/fecabrall/omni-action-hub@sha256:35abfee2a453caa0e22d92abe43799b28a4dd0b890a04fd1eded808bd544c4ee

# ─── Plow (transporte iMessage) ─────────────────────────────────────────────
# Guia: https://github.com/plow-pbc/plow-agents#quickstart
# Execute: login → lines → mint dentro da pasta do projeto.
# O arquivo deve existir antes de subir o container.
PLOW_CREDENTIALS_FILE=./plow-credentials

# ─── Gemini (análise visual) ────────────────────────────────────────────────
# Crie sua chave em: https://aistudio.google.com/app/apikey
# Docs: https://ai.google.dev/gemini-api/docs/api-key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ─── Linear (destino dos tickets) ───────────────────────────────────────────
# Chave pessoal: https://linear.app/settings/api
# Use um time onde você pode criar issues e fazer upload de arquivos.
LINEAR_API_KEY=

# UUID do time: abra o Linear → menu de comandos → "Copy model UUID"
LINEAR_TEAM_ID=

# Opcional — UUID de um projeto dentro do time acima. Deixe vazio se não usar.
LINEAR_PROJECT_ID=

# ─── Plow Chat ID ───────────────────────────────────────────────────────────
# Após o mint, execute: python3 scripts/setup.py --chat-id
# Cole aqui o cht_... impresso.
OMNI_ALLOWED_CHAT_ID=

# ─── Ajustes opcionais ──────────────────────────────────────────────────────
OMNI_WORKERS=2

# Agent Index — preencha após registro oficial na competição. Não é uma API key.
# Sem um ID registrado o app funciona normalmente, só não reporta telemetria.
AGENT_ID=
